<configuration>

    <!-- console appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %5level --- [%thread] %-40.40logger{39} : %msg%n</pattern>
        </encoder>
    </appender>

    <!-- info appender -->
    <appender name="MSG_FILE" class="ch.qos.logback.core.FileAppender">
        <file>logs_${NODE_INDEX}.txt</file>
        <append>true</append>
        <prudent>true</prudent>
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>

        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>INFO</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
    </appender>

    <!-- error appender -->
    <appender name="ERR_FILE" class="ch.qos.logback.core.FileAppender">
        <file>error_${NODE_INDEX}.txt</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %5level --- [%thread] %logger{39} : %msg%n%ex{full}</pattern>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="MSG_FILE"/>
        <appender-ref ref="ERR_FILE"/>
    </root>

</configuration>
