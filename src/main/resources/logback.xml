<configuration>
    <appender name="ERR_FILE" class="ch.qos.logback.core.FileAppender">
        <file>errors.txt</file>
        <append>true</append>

        <!-- Safe for multiple JVMs writing to the same file -->
        <prudent>true</prudent>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %5level --- [%15.15thread] %-40.40logger{39} : %msg%n%ex{full}</pattern>
        </encoder>

        <!-- Only write ERROR+ -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
    </appender>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>DENY</onMatch>
            <onMismatch>NEUTRAL</onMismatch>
        </filter>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %5level --- [%thread] %-40.40logger{39} : %msg%n</pattern>
        </encoder>
    </appender>


    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ERR_FILE"/>
    </root>

</configuration>
